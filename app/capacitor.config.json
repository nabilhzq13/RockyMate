{
  "appId": "io.github.nabilhzq13.rocksane",
  "appName": "Rocksane",
  "webDir": "www",
  "backgroundColor": "#14181c",
  "ios": {
    "contentInset": "never",
    "scrollEnabled": false,
    "allowsLinkPreview": false
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "launchShowDuration": 3000,
      "backgroundColor": "#14181c",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "SystemBars": {
      "insetsHandling": "css",
      "style": "DEFAULT"
    }
  }
}
