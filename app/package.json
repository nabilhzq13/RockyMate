{
  "name": "rocksane-app",
  "version": "1.0.0",
  "private": true,
  "description": "Rocksane for iPhone and Android: the web app in a Capacitor shell, with haptics, the system bars, the back button and the one-time Rocksane Pro purchase.",
  "scripts": {
    "fonts": "node scripts/make-fonts.mjs",
    "bridge": "esbuild build/bridge.src.js --bundle --format=iife --minify --target=es2019,safari15 --outfile=build/bridge.js",
    "web": "npm run bridge && node scripts/build-web.mjs",
    "sync": "npm run web && cap sync",
    "assets": "capacitor-assets generate --ios --android --iconBackgroundColor '#ffd43b' --iconBackgroundColorDark '#ffd43b' --splashBackgroundColor '#e7eaed' --splashBackgroundColorDark '#101316'",
    "ios": "npm run sync && cap open ios",
    "android": "npm run sync && cap open android"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/splash-screen": "8.0.2",
    "@capgo/native-purchases": "8.9.6"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/permanent-marker": "5.3.0",
    "esbuild": "0.25.10"
  },
  "engines": {
    "node": ">=22"
  }
}
